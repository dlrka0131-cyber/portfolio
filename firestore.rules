rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_storage/{document} {
      // Site content (photos, curriculum images) is public, so anyone can read.
      // Only the signed-in teacher account may write/delete.
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'dlrka0131@gmail.com';
    }
  }
}
